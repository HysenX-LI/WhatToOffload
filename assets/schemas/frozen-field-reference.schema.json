{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/what-to-offload/frozen-field-reference.schema.json",
  "title": "WhatToOffload frozen field reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reference_version", "fields"],
  "properties": {
    "schema_version": {"const": 1},
    "reference_version": {"type": "string", "minLength": 1},
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject_ref", "field", "expected_status"],
        "properties": {
          "subject_ref": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
          "field": {"type": "string", "minLength": 1},
          "expected_status": {"enum": ["available", "missing", "not_applicable"]},
          "expected_source_ids": {"$ref": "#/$defs/idArray"},
          "expected_candidate_ids": {"$ref": "#/$defs/idArray"},
          "expected_evidence_ids": {"$ref": "#/$defs/idArray"},
          "expected_value_hash": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"}
        }
      }
    }
  },
  "$defs": {
    "idArray": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
