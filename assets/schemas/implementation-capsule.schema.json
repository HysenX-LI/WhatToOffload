{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HysenX-LI/WhatToOffload/assets/schemas/implementation-capsule.schema.json",
  "title": "WhatToOffload implementation capsule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capsule_version",
    "capsule_id",
    "source",
    "target",
    "decisions",
    "public_contract",
    "change_plan",
    "acceptance",
    "build_budget",
    "stop_conditions",
    "unresolved"
  ],
  "properties": {
    "capsule_version": {"const": 1},
    "capsule_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design_id", "design_version", "input_version", "quality_boundary", "accepted_tradeoffs", "authorization_scope", "references"],
      "properties": {
        "design_id": {"type": "string", "minLength": 1},
        "design_version": {"type": "string", "minLength": 1},
        "input_version": {"type": "string", "minLength": 1},
        "quality_boundary": {"type": "string", "minLength": 1},
        "accepted_tradeoffs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "authorization_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "stack", "package", "scaffold_id", "components", "context_paths", "allowed_changes", "immutable_paths", "dependencies"],
      "properties": {
        "mode": {"enum": ["existing_project", "standalone_python_runner"]},
        "stack": {"type": "string", "minLength": 1},
        "package": {"type": ["string", "null"]},
        "scaffold_id": {"type": ["string", "null"]},
        "components": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "context_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "allowed_changes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "immutable_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_class", "nodes"],
      "properties": {
        "workflow_class": {"enum": ["short_lived_bounded", "durable_asynchronous"]},
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "capability_role", "implementation", "input_contract", "output_contract"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "capability_role": {"enum": ["code", "tool", "jev", "small_llm", "strong_llm_or_agent", "human"]},
              "implementation": {"type": "string", "minLength": 1},
              "input_contract": {"type": "object"},
              "output_contract": {"type": "object"}
            }
          }
        }
      }
    },
    "public_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint", "input_schema", "output_schema", "statuses", "configuration_names"],
      "properties": {
        "entrypoint": {"type": "string", "minLength": 1},
        "input_schema": {"type": "object"},
        "output_schema": {"type": "object"},
        "statuses": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "configuration_names": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "change_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "action", "responsibility"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "action": {"enum": ["create", "modify", "preserve"]},
          "responsibility": {"type": "string", "minLength": 1}
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cases", "commands", "final_command_index"],
      "properties": {
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "input", "expected"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "input": {},
              "expected": {}
            }
          }
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "final_command_index": {"type": "integer", "minimum": 0}
      }
    },
    "build_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_seconds", "max_tool_calls", "max_test_commands", "max_input_tokens"],
      "properties": {
        "wall_seconds": {"type": "integer", "minimum": 1},
        "max_tool_calls": {"type": "integer", "minimum": 1},
        "max_test_commands": {"type": "integer", "minimum": 1},
        "max_input_tokens": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "unresolved": {"type": "array", "maxItems": 0}
  }
}
